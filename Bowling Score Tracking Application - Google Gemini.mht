.content-library.loading .picker-loading-container { display: flex; background-color: rgb(240, 244, 249); }

.dark-mode.loading .picker-loading-container { background-color: rgb(40, 42, 44); }

.dark-mode .picker-close-button { fill: white; }

.picker-close-button:hover { background-color: rgba(109, 118, 124, 0.12); }

.picker-close-button:active { background-color: rgba(109, 118, 124, 0.12); }

